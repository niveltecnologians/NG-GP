generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Fila única (id fijo "singleton") con la personalización de marca de todo
// el sistema: nombre de la app, logo pequeño y una imagen/portada grande.
model AppSettings {
  id             String   @id @default("singleton")
  appName        String   @default("Gestor de Proyectos")

  logoData       Bytes?
  logoMimeType   String?
  hasLogo        Boolean  @default(false)

  bannerData     Bytes?
  bannerMimeType String?
  hasBanner      Boolean  @default(false)

  updatedAt      DateTime @updatedAt
}

enum Role {
  ADMIN
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum ChatMessageType {
  TEXT
  IMAGE
  AUDIO
  FILE
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          Role     @default(MEMBER)
  createdAt     DateTime @default(now())

  // Perfil
  bio                 String?
  avatarData          Bytes?
  avatarMimeType      String?
  hasAvatar           Boolean @default(false)
  backgroundColor     String?
  backgroundData      Bytes?
  backgroundMimeType  String?
  hasBackgroundImage  Boolean @default(false)

  // Presencia (para mostrar "en línea")
  lastSeenAt          DateTime?

  ownedProjects        Project[]            @relation("ProjectOwner")
  memberships          ProjectMember[]
  tasksAssigned        Task[]               @relation("TaskAssignee")
  tasksCreated         Task[]               @relation("TaskCreator")
  attachments          Attachment[]
  ticketsSent          Ticket[]             @relation("TicketSender")
  ticketsReceived      Ticket[]             @relation("TicketRecipient")
  replies              TicketReply[]
  invitesCreated       InviteCode[]         @relation("InviteCreator")
  invitesUsed          InviteCode[]         @relation("InviteUsedBy")
  chatsSent            ChatMessage[]        @relation("ChatSender")
  chatsReceived        ChatMessage[]        @relation("ChatRecipient")
  conversationsCreated Conversation[]       @relation("ConversationCreator")
  conversations        ConversationMember[]
  mentions             Mention[]
}

model InviteCode {
  id          String    @id @default(cuid())
  code        String    @unique
  role        Role      @default(MEMBER)

  createdById String?
  createdBy   User?     @relation("InviteCreator", fields: [createdById], references: [id], onDelete: SetNull)

  usedById    String?
  usedBy      User?     @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  usedAt      DateTime?

  createdAt   DateTime  @default(now())
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  owner       User     @relation("ProjectOwner", fields: [ownerId], references: [id])
  members     ProjectMember[]
  tasks       Task[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?

  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId  String?
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  attachments Attachment[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Attachment {
  id           String   @id @default(cuid())
  filename     String
  mimeType     String
  size         Int

  // Archivos nuevos: se guardan en Vercel Blob y aquí solo queda la URL
  // (permite subir archivos grandes sin pasar por el límite de tamaño de
  // las funciones serverless). Archivos antiguos: siguen con los bytes
  // guardados directamente en la base de datos, para no perder nada.
  data         Bytes?
  url          String?

  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now())
}

model Ticket {
  id          String        @id @default(cuid())
  subject     String
  body        String
  status      TicketStatus  @default(OPEN)

  senderId    String?
  sender      User?         @relation("TicketSender", fields: [senderId], references: [id], onDelete: SetNull)

  recipientId String?
  recipient   User?         @relation("TicketRecipient", fields: [recipientId], references: [id], onDelete: SetNull)

  replies     TicketReply[]

  // Última vez que cada parte vio el hilo, para poder mostrar un contador
  // de "no leídos" en la bandeja de entrada.
  recipientReadAt DateTime?
  senderReadAt    DateTime?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model TicketReply {
  id        String   @id @default(cuid())
  body      String

  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model ChatMessage {
  id          String          @id @default(cuid())
  type        ChatMessageType @default(TEXT)
  body        String?
  editedAt    DateTime?

  // Igual que en Attachment: los archivos nuevos van a Vercel Blob (fileUrl)
  // para poder ser grandes; los que ya estaban guardados como bytes
  // (fileData) se conservan tal cual.
  fileData     Bytes?
  fileUrl      String?
  fileName     String?
  fileMimeType String?
  fileSize     Int?

  // Conversación a la que pertenece (1 a 1 o grupal). Los mensajes nuevos
  // siempre la tienen; ver más abajo cómo se adoptan los mensajes antiguos.
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Si no es null, este mensaje es una respuesta dentro del hilo de otro
  // mensaje (como los hilos de Slack). Los mensajes "normales" del canal
  // tienen parentMessageId = null.
  parentMessageId String?
  parentMessage   ChatMessage?  @relation("MessageReplies", fields: [parentMessageId], references: [id], onDelete: SetNull)
  replies         ChatMessage[] @relation("MessageReplies")

  senderId    String?
  sender      User?           @relation("ChatSender", fields: [senderId], references: [id], onDelete: SetNull)

  // Campos originales de la primera versión del chat (solo 1 a 1, sin
  // grupos). Se conservan para no perder el historial de mensajes ya
  // enviados; los mensajes nuevos usan conversationId en su lugar.
  recipientId String?
  recipient   User?           @relation("ChatRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  readAt      DateTime?

  createdAt   DateTime        @default(now())

  mentions    Mention[]

  @@index([senderId, recipientId])
  @@index([recipientId, senderId])
  @@index([conversationId])
  @@index([parentMessageId])
}

// Registra que un mensaje mencionó (con @Nombre) a un usuario, para poder
// mostrarle un panel de "te mencionaron" en el chat.
model Mention {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  createdAt DateTime    @default(now())

  @@unique([messageId, userId])
  @@index([userId])
}

model Conversation {
  id          String   @id @default(cuid())
  isGroup     Boolean  @default(false)
  name        String?  // solo se usa en grupos

  createdById String?
  createdBy   User?    @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  members     ConversationMember[]
  messages    ChatMessage[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
}
